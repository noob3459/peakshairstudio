# --- Required in production ---------------------------------------------
# Postgres connection string (e.g. a Neon database added from the Vercel Marketplace).
# Leave unset in local development to use an embedded throwaway database in .data/.
DATABASE_URL=

# The one email address allowed to sign in to /admin.
OWNER_EMAIL=

# Scrypt hash of the owner's password. Generate with: npm run owner:setup
OWNER_PASSWORD_HASH=

# Random string of 32+ characters used to sign session cookies. `npm run owner:setup` prints one.
SESSION_SECRET=

# --- Optional ------------------------------------------------------------
# Public origin of the site, used for canonical URLs and share metadata.
NEXT_PUBLIC_SITE_URL=https://aidennsdesigns.com

# Website and design inquiries are emailed to aidennq29@gmail.com when both
# Resend settings below are configured. All inquiries are also saved in /admin/inquiries.
RESEND_API_KEY=
INQUIRY_FROM=
